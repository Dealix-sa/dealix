{
  "schema_version": "1.1",
  "source_issue": 1028,
  "purpose": "Connect canonical Dealix Company Intelligence entities into governed, evidence-backed, cross-department operating loops.",
  "canonical_entity_registry": "dealix/registers/company_intelligence_entity_ownership.json",
  "rules": {
    "dealix_is_source_of_truth": true,
    "external_tools_are_adapters_only": true,
    "draft_only_default": true,
    "external_effect_requires_approval": true,
    "public_data_does_not_imply_consent": true,
    "revenue_requires_payment_proof": true,
    "delivery_requires_completion_proof": true,
    "customer_value_requires_acceptance_and_value_proof": true,
    "renewal_requires_specific_approval": true,
    "closed_loop_requires_outcome_learning_and_command": true,
    "synthetic_runs_must_be_marked": true
